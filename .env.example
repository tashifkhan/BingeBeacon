# ============================================================
# BingeBeacon — single master config (backend + frontend)
#
#   cp .env.example .env
#   ln -sfn ../.env web/.env.local     # so `bun dev` sees the same file
#
# Backend values are read at RUNTIME (Viper: database.host -> DATABASE_HOST).
# VITE_* values are baked into the browser bundle at BUILD time and are
# PUBLIC — never put a secret behind that prefix.
#
# Full reference, including how to obtain every credential:
#   docs/environment.md
# Quote any value containing spaces.
# ============================================================

# --- Server ---
SERVER_PORT=8080
SERVER_ENVIRONMENT=development                # development | production
SERVER_CORS_ORIGINS=http://localhost:3000     # not needed when same-origin behind Caddy
SERVER_INTERNAL_API_KEY=                      # REQUIRED in prod: openssl rand -hex 32
APP_ADDRESS=:80                               # Caddy site address; a bare hostname enables auto-HTTPS

# --- Database (PostgreSQL 16+) ---
DATABASE_HOST=localhost                       # compose overrides this to `postgres`
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=                            # REQUIRED: openssl rand -base64 24
DATABASE_DBNAME=bingebeacon
DATABASE_SSLMODE=disable                      # `require` for a managed/remote database

# --- Redis 7+ ---
REDIS_ADDR=localhost:6379                     # compose overrides this to `redis:6379`
REDIS_PASSWORD=                               # if set, prod compose starts Redis with --requirepass
REDIS_DB=0

# --- JWT ---
JWT_SECRET=                                   # REQUIRED, 32+ chars: openssl rand -base64 48
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# --- TMDB (REQUIRED — core catalog) ---
# themoviedb.org/settings/api -> "API Key (v3 auth)", the 32-char hex string.
# The longer v4 Read Access Token (starts with eyJ) will NOT work here.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# --- OMDb (optional — IMDb / Rotten Tomatoes ratings) ---
# omdbapi.com/apikey.aspx -> FREE tier (1k/day). Activate via the emailed link.
OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com

# --- TheTVDB (optional — episode air-date backfill) ---
# thetvdb.com/dashboard/account/apikey -> v4 key.
# PIN is only needed for user-supported (subscriber) keys.
THETVDB_API_KEY=
THETVDB_PIN=
THETVDB_BASE_URL=https://api4.thetvdb.com/v4

# --- MovieGlu (optional — cinema showtimes; commercial, apply for access) ---
# movieglu.com/contact-us — they issue the key, client ID and Basic credentials.
# printf '%s' 'user:pass' | base64   ->  MOVIEGLU_AUTHORIZATION="Basic <that>"
MOVIEGLU_API_KEY=
MOVIEGLU_AUTHORIZATION=
MOVIEGLU_CLIENT_ID=
MOVIEGLU_TERRITORY=US
MOVIEGLU_BASE_URL=https://api.movieglu.com

# --- Firebase Admin (optional — push delivery) ---
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Save the JSON as secrets/firebase-credentials.json (gitignored).
# Compose overrides this path to /app/secrets/firebase-credentials.json.
FCM_CREDENTIALS_FILE=firebase-credentials.json

# --- Firebase Web SDK (public by design) ---
# Firebase console -> Project settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging -> Web Push certificates -> Generate key pair (PUBLIC key)
VITE_FIREBASE_VAPID_KEY=

# --- Frontend API base ---
# Local dev (bun dev + go run): http://localhost:8080/api/v1
# Docker compose behind Caddy:  /api/v1   <- same-origin, no CORS needed
VITE_API_URL=http://localhost:8080/api/v1
